# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js Build Output
/.next/
/out/
/build

# Debug & Error Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
next-panic-*.log
*.log

# Environment Variables (Keep credentials private)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Vercel Deployment Cache
.vercel

# TypeScript & Next.js Typings
*.tsbuildinfo
next-env.d.ts

# Playwright Test & Scraping Artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
data_scraped_*.json

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python / R Local Artifacts (if running scripts)
__pycache__/
*.py[cod]
*$py.class
.Rhistory
.RData
.Rproj.user
Rplots.pdf
